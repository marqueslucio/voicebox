{
  "name": "voicebox",
  "version": "0.6.0",
  "private": true,
  "workspaces": [
    "app",
    "tauri"
  ],
  "scripts": {
    "dev": "bun run setup:dev && cd tauri && bun run tauri dev",
    "dev:server": "uvicorn backend.main:app --reload --port 17495",
    "setup:dev": "bun run scripts/setup-dev-sidecar.js",
    "build": "./scripts/build-server.sh && cd tauri && bun run tauri build",
    "build:server": "./scripts/build-server.sh",
    "update:icons": "./scripts/update-icons.sh",
    "lint": "biome lint .",
    "typecheck": "bunx tsc -p app/tsconfig.json --noEmit",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "bun run typecheck && bun run --cwd tauri build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@types/node": "^20.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.8"
}
